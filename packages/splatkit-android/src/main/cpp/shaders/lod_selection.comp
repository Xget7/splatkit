#version 450
// Portable workgroup scans, no subgroup-width or subgroup-operation requirements.
layout(local_size_x = 128) in;
layout(std140, set = 0, binding = 0) uniform Camera {
  mat4 view; mat4 proj; vec2 focal; vec2 tanHalfFov;
  vec2 screenSize; uint outputLinear; uint pad; vec4 cameraPosition;
} cam;
struct Cluster {
  vec4 centerRadius; vec4 extentError;
  float colorVariance; float opacity;
  uint node; uint childStart; uint childCount; uint leafStart; uint leafCount; uint subtreeLeaves;
};
layout(std430, set = 0, binding = 1) readonly buffer Nodes { Cluster nodes[]; };
layout(std430, set = 0, binding = 2) readonly buffer Leaves { uint leaves[]; };
layout(std430, set = 0, binding = 3) buffer Scratch { uint s[]; };
layout(std430, set = 0, binding = 4) writeonly buffer Indices { uint indices[]; };
layout(push_constant) uniform Config {
  uint phase; uint capacity; uint costs; uint offsets;
  uint costGroups; uint groups; uint blocks; uint frontier0;
  uint frontier1; uint packets; uint histogram; float pixelLimit; float colorWeight; uint cull;
} p;
// State words: count, active, packets, cutoff, limited, evaluated, groups, next,
// dispatch xyz, emit xyz, outputDelta, packetDelta, scan xyz, frontier parity, tieBudget.
// Splits above the cutoff bucket refine, below it are denied, and within it refine in
// frontier order while their cost fits in tieBudget.
const uint SPLIT = 0x80000000u, DROP = 0x40000000u, COST = 0x3fffffffu;
// Split candidates are ranked by screen error on a log scale, 8 buckets per octave from
// 2^-8 to 2^24 px, so a level over capacity denies the smallest errors, not an index suffix.
const uint ERROR_BUCKETS = 256;
shared uvec4 scanValues[128];
shared uint localHistogram[ERROR_BUCKETS];
uvec4 get4(uint base, uint i) { uint a = base + i * 4; return uvec4(s[a],s[a+1],s[a+2],s[a+3]); }
void put4(uint base, uint i, uvec4 v) { uint a = base + i * 4; s[a]=v.x; s[a+1]=v.y; s[a+2]=v.z; s[a+3]=v.w; }
uint currentFrontier() { return s[19] == 0 ? p.frontier0 : p.frontier1; }
uint nextFrontier() { return s[19] == 0 ? p.frontier1 : p.frontier0; }
// Inclusive workgroup scan. Every invocation participates, including tail lanes.
uvec4 scan(uvec4 value) {
  uint lane = gl_LocalInvocationIndex;
  scanValues[lane] = value; barrier();
  for (uint step = 1; step < 128; step *= 2) {
    uvec4 addend = lane >= step ? scanValues[lane-step] : uvec4(0);
    barrier(); scanValues[lane] += addend; barrier();
  }
  return scanValues[lane];
}
bool outside(Cluster n) {
  vec3 v = (cam.view * vec4(n.centerRadius.xyz,1)).xyz;
  float z = -v.z, r = n.centerRadius.w;
  float guard = 2 * max(z,0) / max(min(cam.focal.x,cam.focal.y),1);
  return z+r <= 0 || any(greaterThan(abs(v.xy)-z*cam.tanHalfFov,
                                     r*sqrt(1+cam.tanHalfFov*cam.tanHalfFov)+guard));
}
uint errorBucket(float pixels) {
  if (!(pixels > 0)) return 0;
  return uint(clamp(floor(log2(pixels)*8)+64, 0, float(ERROR_BUCKETS-1)));
}
float errorPixels(Cluster n) {
  vec3 v = (cam.view * vec4(n.centerRadius.xyz,1)).xyz;
  float depth = max(-v.z-n.centerRadius.w,1e-4);
  float appearance = sqrt(n.colorVariance);
  float error = n.extentError.w+n.centerRadius.w*min(appearance,1);
  return error*max(cam.focal.x,cam.focal.y)/depth * sqrt(1+dot(v.xy,v.xy)/(depth*depth)) *
         max(n.opacity,0.1)*(1+p.colorWeight*appearance);
}
void main() {
  uint t = gl_GlobalInvocationID.x, lane = gl_LocalInvocationIndex, group = gl_WorkGroupID.x;
  if (p.phase == 0) {
    if (t == 0) {
      for (uint i=0;i<21;++i) s[i]=0;
      s[1]=1; s[6]=1; s[8]=1; s[9]=1; s[10]=1;
      s[12]=1; s[13]=1; s[16]=1; s[17]=1; s[18]=1;
      s[p.frontier0]=0;
      for (uint b=0;b<ERROR_BUCKETS;++b) s[p.histogram+b]=0;
    }
  } else if (p.phase == 1) {
    uint extra=0, flags=0, dropped=0, bucket=0;
    if (t<s[1]) {
      Cluster n=nodes[s[currentFrontier()+t]];
      if (p.cull != 0 && outside(n)) { flags=DROP; dropped=1; }
      else if (n.childCount+n.leafCount>1) {
        float error=errorPixels(n);
        if (p.pixelLimit==0 || error>p.pixelLimit) {
          flags=SPLIT; extra=n.childCount+n.leafCount-1; bucket=errorBucket(error);
        }
      } else if (n.childCount==1 && n.leafCount==0) flags=SPLIT;
    }
    for (uint b=lane;b<ERROR_BUCKETS;b+=128) localHistogram[b]=0;
    uvec4 value=uvec4(extra,dropped,0,0), inclusive=scan(value);
    if (t<s[1]) { s[p.costs+2*t]=extra|flags; s[p.costs+2*t+1]=bucket; }
    if (lane==127) put4(p.costGroups,group,inclusive);
    // Workgroup histogram first: one storage atomic per occupied bucket per workgroup.
    if (extra>0) atomicAdd(localHistogram[bucket],extra);
    barrier();
    for (uint b=lane;b<ERROR_BUCKETS;b+=128)
      if (localHistogram[b]>0) atomicAdd(s[p.histogram+b],localHistogram[b]);
  } else if (p.phase == 2 || p.phase == 6) {
    uint base=p.phase==2 ? p.costGroups : p.groups;
    uvec4 value=t<s[6] ? get4(base,t) : uvec4(0), inclusive=scan(value);
    if (t<s[6]) put4(base,t,inclusive-value);
    if (lane==127) put4(p.blocks,group,inclusive);
  } else if (p.phase == 3) {
    if (t==0) {
      uvec4 total=uvec4(0); uint n=(s[6]+127)/128;
      for (uint i=0;i<n;++i) { uvec4 v=get4(p.blocks,i); put4(p.blocks,i,total); total+=v; }
      put4(p.blocks,n,total);
    }
  } else if (p.phase == 4) {
    // Over capacity, keep the largest screen errors: whole buckets while they fit, then
    // part of the next in frontier order.
    if (t==0) {
      uvec4 total=get4(p.blocks,(s[6]+127)/128);
      uint available=p.capacity-s[0]-s[1]+total.y;
      s[3]=0; s[20]=0xffffffffu;
      if (total.x>available) {
        uint accepted=0;
        for (uint b=ERROR_BUCKETS;b-->0;) {
          uint cost=s[p.histogram+b];
          if (accepted+cost>available) { s[3]=b; s[20]=available-accepted; break; }
          accepted+=cost;
        }
      }
      for (uint b=0;b<ERROR_BUCKETS;++b) s[p.histogram+b]=0;
    }
  } else if (p.phase == 11) {
    // Frontier-order cost of the splits in the cutoff bucket, scanned like the costs.
    uint tie=0;
    if (t<s[1]) {
      uint cost=s[p.costs+2*t];
      if ((cost&SPLIT)!=0 && s[p.costs+2*t+1]==s[3]) tie=cost&COST;
    }
    uvec4 value=uvec4(tie,0,0,0), inclusive=scan(value);
    if (t<s[1]) s[p.offsets+4*t]=inclusive.x-tie;
    if (lane==127) put4(p.costGroups,group,inclusive);
  } else if (p.phase == 5) {
    uint flags=DROP, kids=0, splats=0, packets=0, denied=0;
    if (t<s[1]) {
      flags=s[p.costs+2*t]&~COST;
      uint extra=s[p.costs+2*t]&COST, bucket=s[p.costs+2*t+1];
      // offsets[t] still holds this node's rank; it is replaced below.
      uint tie=get4(p.blocks,group/128).x+get4(p.costGroups,group).x+s[p.offsets+4*t];
      bool refused=bucket<s[3] || (bucket==s[3] && tie+extra>s[20]);
      if ((flags&SPLIT)!=0 && extra>0 && refused) { flags=0; denied=1; }
      if ((flags&DROP)==0) {
        Cluster n=nodes[s[currentFrontier()+t]];
        kids=(flags&SPLIT)!=0 ? n.childCount : 0;
        splats=(flags&SPLIT)!=0 ? n.leafCount : 1;
        packets=splats>128 ? 1 : 0;
      }
    }
    uvec4 v=uvec4(kids,splats,packets,denied), inclusive=scan(v);
    if (t<s[1]) put4(p.offsets,t,uvec4((inclusive-v).xyz,flags));
    if (lane==127) put4(p.groups,group,inclusive);
  } else if (p.phase == 7) {
    if (t==0) {
      uvec4 total=get4(p.blocks,(s[6]+127)/128);
      s[7]=total.x; s[14]=total.y; s[15]=total.z;
      s[4]+=total.w; s[5]+=s[1];
    }
  } else if (p.phase == 8) {
    if (t<s[1]) {
      uvec4 local=get4(p.offsets,t), prefix=get4(p.groups,group)+get4(p.blocks,group/128);
      if ((local.w&DROP)!=0) return;
      Cluster n=nodes[s[currentFrontier()+t]];
      bool split=(local.w&SPLIT)!=0;
      if (split) for (uint k=0;k<n.childCount;++k) s[nextFrontier()+prefix.x+local.x+k]=n.childStart+k;
      uint count=split ? n.leafCount : 1, destination=s[0]+prefix.y+local.y;
      if (count>128) put4(p.packets,s[2]+prefix.z+local.z,uvec4(n.leafStart,count,destination,0));
      else if (!split) indices[destination]=n.node;
      else for (uint k=0;k<count;++k) indices[destination+k]=leaves[n.leafStart+k];
    }
  } else if (p.phase == 9) {
    if (t==0) {
      s[0]+=s[14]; s[2]+=s[15]; s[1]=s[7]; s[6]=(s[1]+127)/128;
      s[8]=s[6]; s[11]=s[2]; s[16]=(s[6]+127)/128; s[19]^=1;
    }
  } else if (p.phase == 10) {
    if (group<s[2]) {
      uvec4 packet=get4(p.packets,group);
      for (uint k=lane;k<packet.y;k+=128) indices[packet.z+k]=leaves[packet.x+k];
    }
  }
}
