{
  "name": "splatkit-react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode release",
    "ios": "react-native run-ios --mode Release --buildFolder build/dd --extra-params ONLY_ACTIVE_ARCH=YES",
    "ios:build": "react-native build-ios --mode Release --buildFolder build/dd --extra-params ONLY_ACTIVE_ARCH=YES",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "patch:tooling": "node ../../packages/react-native-splatkit/scripts/patch-braces.cjs --node-modules node_modules",
    "postinstall": "npm run patch:tooling",
    "check:tooling": "npm run patch:tooling -- --check && node --test ../../packages/react-native-splatkit/tests/braces-security.test.cjs",
    "prestart": "npm run patch:tooling",
    "start": "react-native start"
  },
  "dependencies": {
    "@splatkit/react-native": "file:../../packages/react-native-splatkit",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
